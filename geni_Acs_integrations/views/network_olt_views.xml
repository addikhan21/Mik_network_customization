<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_network_olt_tree" model="ir.ui.view">
        <field name="name">network.olt.tree</field>
        <field name="model">network.olt</field>
        <field name="arch" type="xml">
            <list string="OLTs">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="brand"/>
                <field name="location"/>
                <field name="nas_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_network_olt_form" model="ir.ui.view">
        <field name="name">network.olt.form</field>
        <field name="model">network.olt</field>
        <field name="arch" type="xml">
            <form string="OLT">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="OLT Name e.g. Core OLT Huawei"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ip_address" placeholder="e.g. 192.168.1.100"/>
                            <field name="brand"/>
                        </group>
                        <group>
                            <field name="location" placeholder="e.g. Rack 3 / Main Datacenter"/>
                            <field name="nas_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_network_olt" model="ir.actions.act_window">
        <field name="name">OLTs</field>
        <field name="res_model">network.olt</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first OLT record!
            </p>
        </field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_network_olt_list"
              name="OLTs"
              parent="network.network_menu_root"
              action="action_network_olt"
              sequence="15"/>
</odoo>
